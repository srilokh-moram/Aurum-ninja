# ── NinjaTrader 8 ──────────────────────────────────────────────
# Account name exactly as shown in NT8 (Accounts tab)
NT8_ACCOUNT=Sim101

# Instrument as shown in NT8 — update this every contract roll (~every 2 months)
NT8_SYMBOL=MGC 06-25

# ATI incoming folder (NT8 watches here for order commands)
# Default works if you leave it blank — only set if NT8 is on a different drive
NT8_INCOMING_DIR=%USERPROFILE%\Documents\NinjaTrader 8\incoming

# Price feed file written by AurumFeed.cs indicator
NT8_FEED_FILE=%USERPROFILE%\Documents\NinjaTrader 8\aurum_feed.json

# ── Grid Strategy ───────────────────────────────────────────────
LOT_SIZE=1          # contracts (1 MGC = 10 oz gold)
GRID_GAP=5.0        # dollars per oz between grid levels ($5/oz = $50/contract profit)
SLEEP_SECONDS=1

# ── Daily Summary (optional Telegram alerts) ────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
